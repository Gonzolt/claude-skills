    classDef restored fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#78350f
    classDef dir fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#334155,stroke-dasharray:3 3
    classDef current fill:#4f46e5,stroke:#4338ca,stroke-width:2px,color:#ffffff

    subgraph MainPath["主路径 Main Path"]
